#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Stage 2: Multi-Scale Spatial-Temporal Convolutional Backbone + FPN Neck
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer CamTensorIn { vec4 pixels[]; } uCamTensor;
layout(std430, binding = 1) readonly buffer PrevCamTensorIn { vec4 pixels[]; } uPrevCamTensor;
layout(std430, binding = 2) readonly buffer SoilPatchIn { vec4 patches[]; } uSoilPatch;
layout(std430, binding = 3) writeonly buffer FeatS4Out { vec4 feat[]; } uFeatS4;
layout(std430, binding = 4) writeonly buffer FeatS5Out { vec4 feat[]; } uFeatS5;

layout(push_constant) uniform BackbonePC {
    uint camWidth;
    uint camHeight;
    uint featWidth;
    uint featHeight;
    uint patchCols;
    uint patchRows;
    uint hasPrevTensor;
    uint pad0;
    vec4 horizon03;
    vec4 horizon47;
    vec4 horizonSlope03;
    vec4 horizonSlope47;
} pc;

vec3 fetchCurr(uint cam, int x, int y) {
    const int cx = clamp(x, 0, int(pc.camWidth) - 1);
    const int cy = clamp(y, 0, int(pc.camHeight) - 1);
    return uCamTensor.pixels[(cam * pc.camHeight + uint(cy)) * pc.camWidth + uint(cx)].rgb;
}

vec3 fetchPrev(uint cam, int x, int y) {
    const int cx = clamp(x, 0, int(pc.camWidth) - 1);
    const int cy = clamp(y, 0, int(pc.camHeight) - 1);
    return uPrevCamTensor.pixels[(cam * pc.camHeight + uint(cy)) * pc.camWidth + uint(cx)].rgb;
}

float satOf(vec3 col) {
    const float mx = max(col.r, max(col.g, col.b));
    const float mn = min(col.r, min(col.g, col.b));
    return (mx > 1e-4) ? ((mx - mn) / mx) : 0.0;
}

// Painted (saturated) or silver-metallic vehicle body sample used to ground dark foreground tire/underbody pixels
bool isVehBodySample(vec3 s) {
    const float sf = satOf(s);
    const float sl = luma(s);
    return (sf > 0.38 && sl > 0.10) ||
           (sf >= 0.14 && sf < 0.24 && s.b >= s.g && s.g >= s.r && sl > 0.215);
}

bool isDarkAsphaltSample(vec3 s) {
    return (s.b >= s.g * 0.96) && (satOf(s) < 0.36) && (luma(s) < 0.225);
}

shared vec4 s_block[8][8][4];

void main() {
    const uint fx = gl_GlobalInvocationID.x;
    const uint fy = gl_GlobalInvocationID.y;
    const uint cam = gl_GlobalInvocationID.z;
    if (fx >= pc.featWidth || fy >= pc.featHeight) return;

    const float baseHorizV = (cam < 4u) ? pc.horizon03[cam] : pc.horizon47[cam - 4u];
    const float horizSlope = (cam < 4u) ? pc.horizonSlope03[cam] : pc.horizonSlope47[cam - 4u];

  const float kRefCamW = 320.0;
  const float kRefCamH = 240.0;
  const int kMaxCellSteps = 8;
  const int x0 = int((fx * pc.camWidth) / pc.featWidth);
  const int x1 = int(((fx + 1u) * pc.camWidth) / pc.featWidth);
  const int y0 = int((fy * pc.camHeight) / pc.featHeight);
  const int y1 = int(((fy + 1u) * pc.camHeight) / pc.featHeight);
  const int stepX = max(1, (x1 - x0) / kMaxCellSteps);
  const int stepY = max(1, (y1 - y0) / kMaxCellSteps);
  const int sx = max(1, int(round(float(pc.camWidth) / kRefCamW)));
  const int sy = max(1, int(round(float(pc.camHeight) / kRefCamH)));

    float gxAcc = 0.0, gyAcc = 0.0, motAcc = 0.0;
    float vehScoreAcc = 0.0, pedScoreAcc = 0.0, sigScoreAcc = 0.0, sigStrongAcc = 0.0, poleSignAcc = 0.0, poleStrongAcc = 0.0, roadScoreAcc = 0.0;
    float skyScoreAcc = 0.0, bldgScoreAcc = 0.0, lumAcc = 0.0;
    float samples = 0.0;
    float minObjU = 1.0, maxObjU = 0.0;
    float minObjV = 1.0, maxObjV = 0.0;
    bool hasSubObj = false;

  for (int py = y0; py < y1; py += stepY) {
    for (int px = x0; px < x1; px += stepX) {
      const int spx = min(x1 - 1, px + stepX / 2);
      const int spy = min(y1 - 1, py + stepY / 2);
      const vec3 c = fetchCurr(cam, spx, spy);
      const vec3 p = fetchPrev(cam, spx, spy);
      const float uFrac = float(spx) / float(pc.camWidth);
      const float vFrac = float(spy) / float(pc.camHeight);
      const float camHorizV =
        clamp(baseHorizV + horizSlope * (uFrac - 0.5), 0.34, 0.66);

      const float lC = luma(c);
      const float lL = luma(fetchCurr(cam, spx - 2 * sx, spy));
      const float lR = luma(fetchCurr(cam, spx + 2 * sx, spy));
      const float lU = luma(fetchCurr(cam, spx, spy - 2 * sy));
      const float lD = luma(fetchCurr(cam, spx, spy + 2 * sy));

            const float gx = abs(lR - lL);
            const float gy = abs(lD - lU);
            const float mot = (pc.hasPrevTensor != 0u) ? length(c - p) : 0.0;

            const float maxC = max(c.r, max(c.g, c.b));
            const float minC = min(c.r, min(c.g, c.b));
            const float sat = (maxC > 1e-4) ? ((maxC - minC) / maxC) : 0.0;

            // Sky is blue-dominant over green & red; avoid misclassifying green/cyan traffic lights as sky
            const float isSky = clamp((c.b - c.g) * 4.0, 0.0, 1.0) * clamp((c.b - c.r) * 3.0, 0.0, 1.0) * clamp((lC - 0.42) * 3.0, 0.0, 1.0);
            const float isAsphalt = clamp(1.0 - sat * 3.5, 0.0, 1.0) * clamp(1.0 - abs(lC - 0.16) * 5.0, 0.0, 1.0);
            const bool silverColorMatch = (sat >= 0.14 && sat < 0.235) && c.b >= c.g && c.g >= c.r &&
                                          (c.b <= c.r * 1.32) && lC >= 0.215 && lC <= 0.85;
            const float roadTopV = min(0.47, camHorizV + 0.008);
            const float isSlateGround = (vFrac > roadTopV && c.b >= c.g && c.g >= c.r && sat < 0.60 && (vFrac <= 0.80 || lC >= 0.105) && lC < 0.34 && !silverColorMatch) ? 1.0 : 0.0;
            float isWhiteStripe = 0.0;
            if (sat < 0.20 && lC > 0.42 && (vFrac > 0.49 || vFrac > camHorizV + 0.005)) {
                bool flatRoadStrip = (vFrac > 0.49);
                if (!flatRoadStrip) {
          const vec3 cStripeU4 = fetchCurr(cam, spx, spy - 4 * sy);
          const vec3 cStripeU7 = fetchCurr(cam, spx, spy - 7 * sy);
          const vec3 cStripeD4 = fetchCurr(cam, spx, spy + 4 * sy);
          const vec3 cStripeD7 = fetchCurr(cam, spx, spy + 7 * sy);
                    const bool darkAboveStripe = (luma(cStripeU4) < 0.28 && satOf(cStripeU4) < 0.45) ||
                                                 (luma(cStripeU7) < 0.28 && satOf(cStripeU7) < 0.45);
                    const bool darkBelowStripe = (luma(cStripeD4) < 0.28 && satOf(cStripeD4) < 0.45) ||
                                                 (luma(cStripeD7) < 0.28 && satOf(cStripeD7) < 0.45);
                    flatRoadStrip = darkAboveStripe && darkBelowStripe;
                }
                if (flatRoadStrip) {
                    isWhiteStripe = clamp(1.0 - sat * 5.0, 0.0, 1.0) * clamp((lC - 0.42) * 4.5, 0.0, 1.0);
                }
            }
            const float isAmberCurb = (vFrac > min(0.45, camHorizV + 0.004) && c.r > c.g * 1.05 && c.r < c.g * 1.82 && c.g > c.b * 1.15 && (c.r - c.b) > 0.10) ? 1.0 : 0.0;
            const float isRoad = clamp(isAsphalt + isSlateGround + isWhiteStripe + isAmberCurb, 0.0, 1.0);

            // Emissive red/green signal lenses or deep crimson / bloomed-pink taillights (exclude amber road curbs!)
            const float isRedSig = clamp((c.r - 0.62) * 3.0, 0.0, 1.0) * clamp((c.r - c.g * 1.85) * 3.0, 0.0, 1.0) * (1.0 - isAmberCurb);
            const float isBloomedRed = clamp((c.r - 0.48) * 3.5, 0.0, 1.0) *
                                       clamp((c.r - c.g * 1.24) * 3.5, 0.0, 1.0) *
                                       clamp((c.r - c.b * 1.24) * 3.5, 0.0, 1.0) *
                                       (1.0 - isAmberCurb);
            const float isGrnSig = clamp((c.g - 0.74) * 5.0, 0.0, 1.0) * clamp((c.g - c.r - 0.36) * 4.0, 0.0, 1.0) *
                                   clamp((c.g * 1.06 - c.b) * 12.0, 0.0, 1.0) * (1.0 - isSky) * (1.0 - isRoad) * (vFrac < min(0.41, camHorizV - 0.075) ? 1.0 : 0.05);
            const float isSig = (vFrac < 0.47) ? clamp(isRedSig + isGrnSig, 0.0, 1.0) : 0.0;

            // Mask out ego vehicle's own gold hood/nose/fenders in camera views
            const bool isEgoSelf = (cam == 0u && vFrac > 0.89) ||
                                   (cam == 2u && vFrac > 0.68 && uFrac > 0.15 && uFrac < 0.85) ||
                                   (cam == 3u && uFrac > 0.87 && vFrac > 0.50) ||
                                   (cam == 4u && uFrac < 0.13 && vFrac > 0.50) ||
                                   (cam == 5u && uFrac > 0.66 && vFrac > 0.45) ||
                                   (cam == 6u && uFrac < 0.34 && vFrac > 0.45) ||
                                   (vFrac > 0.89);

            // Narrow vertical poles (sign posts, signal masts): isolated same-sign horizontal ridge/valley + vertical continuity
            bool isPoleMatch = false;
            if (!isEgoSelf && (1.0 - isSky) > 0.5 && vFrac > 0.05 && vFrac < 0.78 &&
                c.b > c.g && c.g > c.r && sat >= 0.32 && sat <= 0.50 && lC >= 0.060 && lC <= 0.54) {
        const vec3 cU4 = fetchCurr(cam, spx, spy - 4 * sy);
        const vec3 cD4 = fetchCurr(cam, spx, spy + 4 * sy);
        const float vertDiff = min(length(cU4 - c), length(cD4 - c));
        if (vertDiff < 0.045) {
          const vec3 cL4 = fetchCurr(cam, spx - 4 * sx, spy);
          const vec3 cR4 = fetchCurr(cam, spx + 4 * sx, spy);
          const vec3 cL8 = fetchCurr(cam, spx - 8 * sx, spy);
          const vec3 cR8 = fetchCurr(cam, spx + 8 * sx, spy);
                    const float dLumL4 = lC - luma(cL4), dLumR4 = lC - luma(cR4);
                    const float dLumL8 = lC - luma(cL8), dLumR8 = lC - luma(cR8);
                    const float dBluL4 = c.b - cL4.b, dBluR4 = c.b - cR4.b;
                    const float dBluL8 = c.b - cL8.b, dBluR8 = c.b - cR8.b;
                    const float maxBgL4 = max(luma(cL4), luma(cR4));
                    const float maxBgL8 = max(luma(cL8), luma(cR8));
                    const float minBgL4 = min(luma(cL4), luma(cR4));
                    const float minBgL8 = min(luma(cL8), luma(cR8));
                    const bool groundLuma = (lC <= 0.35);
          const vec3 cU8 = fetchCurr(cam, spx, spy - 8 * sy);
          const vec3 cU16 = fetchCurr(cam, spx, spy - 16 * sy);
          const vec3 cU24 = fetchCurr(cam, spx, spy - 24 * sy);
                    const bool poleAbove = (cU8.b > cU8.g && cU8.b > cU8.r * 1.15 && satOf(cU8) >= 0.25 && length(cU8 - c) < 0.10) &&
                                           ((cU16.b > cU16.r * 1.12 && !(cU16.g > cU16.r * 1.6 && cU16.g > cU16.b)) ||
                                            (satOf(cU16) < 0.16 && luma(cU16) >= 0.52)) &&
                                           !(cU24.r > cU24.b * 1.15);
                    const bool symGround4 = (minBgL4 >= 0.135 && length(cL4 - cR4) < 0.08 && poleAbove);
                    const bool symGround8 = (minBgL8 >= 0.135 && length(cL8 - cR8) < 0.08 && poleAbove);
                    const bool valley4 = ((maxBgL4 > 0.42 || symGround4) && dLumL4 < -0.032 && dLumR4 < -0.032);
                    const bool valley8 = ((maxBgL8 > 0.42 || symGround8) && dLumL8 < -0.032 && dLumR8 < -0.032);
                    const bool ridge4 = ((groundLuma && ((dLumL4 > 0.020 && dLumR4 > 0.020) || (dBluL4 > 0.028 && dBluR4 > 0.028)) && length(cL4 - cR4) < 0.24) || valley4);
                    const bool ridge8 = ((groundLuma && ((dLumL8 > 0.020 && dLumR8 > 0.020) || (dBluL8 > 0.028 && dBluR8 > 0.028)) && length(cL8 - cR8) < 0.24) || valley8);
                    isPoleMatch = (ridge4 || ridge8);
                }
            }
            bool isSpeedSignMatch = false;
            if (!isEgoSelf && sat < 0.14 && (1.0 - isSky) > 0.5 && (1.0 - isRoad) > 0.5 &&
                vFrac < camHorizV - 0.015 && lC >= 0.62) {
                const int pyHorizA = clamp(int(camHorizV * float(pc.camHeight)), 0, int(pc.camHeight) - 1);
                const int pyHorizB = clamp(int((camHorizV + 0.014) * float(pc.camHeight)), 0, int(pc.camHeight) - 1);
        const vec3 cHLA = fetchCurr(cam, spx - 3 * sx, pyHorizA);
        const vec3 cHRA = fetchCurr(cam, spx + 3 * sx, pyHorizA);
        const vec3 cHLB = fetchCurr(cam, spx - 3 * sx, pyHorizB);
        const vec3 cHRB = fetchCurr(cam, spx + 3 * sx, pyHorizB);
                const bool hasBelowWhiteTruck = (luma(cHLA) >= 0.28 && satOf(cHLA) < 0.18) ||
                                                (luma(cHRA) >= 0.28 && satOf(cHRA) < 0.18) ||
                                                (luma(cHLB) >= 0.28 && satOf(cHLB) < 0.18) ||
                                                (luma(cHRB) >= 0.28 && satOf(cHRB) < 0.18);
                const bool hasBelowBlueCab = (satOf(cHLA) > 0.58 && cHLA.b > cHLA.r * 2.30) ||
                                             (satOf(cHRA) > 0.58 && cHRA.b > cHRA.r * 2.30) ||
                                             (satOf(cHLB) > 0.58 && cHLB.b > cHLB.r * 2.30) ||
                                             (satOf(cHRB) > 0.58 && cHRB.b > cHRB.r * 2.30);
        const vec3 cW15L = fetchCurr(cam, spx - 15 * sx, spy);
        const vec3 cW15R = fetchCurr(cam, spx + 15 * sx, spy);
                const bool extraWideWhite = (luma(cW15L) >= 0.42 && satOf(cW15L) < 0.16 &&
                                             luma(cW15R) >= 0.42 && satOf(cW15R) < 0.16);
                isSpeedSignMatch = (!hasBelowWhiteTruck && !hasBelowBlueCab && !extraWideWhite);
            }
            const float isPoleOrSign = clamp(max(isSig, max(isPoleMatch ? 0.90 : 0.0, isSpeedSignMatch ? 0.90 : 0.0)), 0.0, 1.0);

            // Road band calibrated per-camera to true world horizon scanline camHorizV
            const float roadBand = smoothstep(camHorizV - 0.008, camHorizV + 0.018, vFrac) *
                                   (1.0 - smoothstep(0.85, 0.93, vFrac));
            // Orange/coral pedestrian outfits (e.g. PED_01 {0.976,0.451,0.086}) must not trigger red vehicle taillight bias
            const bool isOrangePed = (c.r > 0.24) && (c.g >= c.r * 0.32) && (c.g > c.b * 1.80) && (sat > 0.50);
            // Crimson-magenta pedestrian outfits (c.b/c.g ~ 1.49 on PED_08; synthetic magenta test cars have c.b/c.g > 2.0)
            const bool isCrimsonPed = (c.r > c.b * 1.40) && (c.b > c.g * 1.24) && (c.b < c.g * 1.85) && (sat > 0.44);
            const float isPedColor = isEgoSelf ? 0.0 : (clamp((sat - 0.44) * 2.8, 0.0, 1.0) * clamp((lC - 0.06) * 5.0, 0.0, 1.0) * (1.0 - isSky) * (1.0 - isRoad));
            const float isPed = isPedColor * roadBand;

            // Vehicle chassis: mid-frame painted car body / red-orange or bloomed taillight / shaded or sunlit truck cargo box
            // Pure red / bloomed-pink taillights have green ~ blue; keep orange/crimson pedestrian outfits off isTail
            const float isTailColor = (c.b < c.g * 1.18 && c.b < c.g + 0.08) ? 1.0 : 0.0;
            const float isTail = max(isRedSig, isBloomedRed) * isTailColor * smoothstep(camHorizV - 0.015, camHorizV + 0.065, vFrac) * (1.0 - isRoad) * ((isCrimsonPed || isOrangePed) ? 0.0 : 1.0);
            const float isVehPaint = isEgoSelf ? 0.0 : (clamp((sat - 0.44) * 2.8, 0.0, 1.0) * clamp((lC - 0.06) * 5.0, 0.0, 1.0) * (1.0 - isSky) * (1.0 - isRoad) * roadBand * (isOrangePed ? 0.55 : (isCrimsonPed ? 0.85 : 1.0)));
            const bool neutralNonSkyRoad = !isEgoSelf && sat < 0.14 && c.b >= c.r * 0.95 && (1.0 - isSky) > 0.5 && (1.0 - isRoad) > 0.5;
            const bool shadedTruckCore = neutralNonSkyRoad && sat < 0.055 && vFrac > 0.06 && vFrac < 0.62 && lC > 0.28 && lC < 0.44 &&
                                         !(sat < 0.045 && lC < 0.354 && vFrac > 0.55);
            const bool shadedTruckPanel = shadedTruckCore ||
                                          (neutralNonSkyRoad && vFrac > 0.06 && vFrac < camHorizV + 0.010 && lC > 0.28 && lC < 0.58);
            const bool sunlitUpperCargo = !isEgoSelf && sat < 0.095 && c.b >= c.r * 0.88 && (1.0 - isSky) > 0.5 && (1.0 - isRoad) > 0.5 &&
                                          vFrac > 0.22 && vFrac < 0.70 && lC >= 0.52 && lC < 0.985;
            const bool sunlitTruckPanel = sunlitUpperCargo || (neutralNonSkyRoad && vFrac > camHorizV + 0.003 && vFrac < min(0.515, camHorizV + 0.025) && lC >= 0.45);
            const float isTruckBox = (shadedTruckPanel || sunlitTruckPanel) ? 0.85 : 0.0;
            // Deep blue-tinted vehicle windshield glass bridges lower bumper/cab to upper roof/cargo box
            const float isVehGlass = (!isEgoSelf && sat > 0.58 && c.b > c.r * 2.30 && c.b > c.g * 1.45 &&
                                      lC > 0.025 && lC < 0.16 && (1.0 - isSky) > 0.5 && (1.0 - isRoad) > 0.5 &&
                                      vFrac > camHorizV - 0.06 && vFrac < 0.58) ? 0.58 : 0.0;
            bool isSilverStripeAA = false;
            if (!isEgoSelf && silverColorMatch && (1.0 - isSky) > 0.5 &&
                vFrac > camHorizV - 0.01 && vFrac < 0.89) {
        const bool horizFlanked =
          isDarkAsphaltSample(fetchCurr(cam, spx - 5 * sx, spy)) &&
          isDarkAsphaltSample(fetchCurr(cam, spx + 5 * sx, spy));
        const bool vertFlanked = (vFrac > camHorizV + 0.018) &&
          isDarkAsphaltSample(fetchCurr(cam, spx, spy - 4 * sy)) &&
          isDarkAsphaltSample(fetchCurr(cam, spx, spy + 4 * sy));
                isSilverStripeAA = horizFlanked || vertFlanked;
            }
            const bool isSilverMetallic = !isEgoSelf && silverColorMatch && !isSilverStripeAA && (1.0 - isSky) > 0.5 &&
                                          vFrac > camHorizV - 0.01 && vFrac < 0.89;
            // Dark foreground tires / underbody shadow directly beneath close vehicle chassis (grounds close Cam0 vBot)
            bool isVehDarkBase = false;
            if (!isEgoSelf && (1.0 - isSky) > 0.5 && vFrac > 0.80 && vFrac < 0.90 && lC < 0.095 && sat < 0.55) {
        const vec3 vU4 = fetchCurr(cam, spx, spy - 4 * sy);
        const vec3 vU8 = fetchCurr(cam, spx, spy - 8 * sy);
        const vec3 vU12 = fetchCurr(cam, spx, spy - 12 * sy);
        if (isVehBodySample(vU4) || isVehBodySample(vU8) || isVehBodySample(vU12)) {
          const vec3 vL3 = fetchCurr(cam, spx - 3 * sx, spy);
          const vec3 vR3 = fetchCurr(cam, spx + 3 * sx, spy);
                    isVehDarkBase = (luma(vL3) < 0.12 || luma(vR3) < 0.12);
                }
            }
            const float isVeh = clamp(isVehPaint + isTail * 1.4 + isTruckBox + isVehGlass + (isSilverMetallic ? 0.78 : 0.0) + (isVehDarkBase ? 0.68 : 0.0), 0.0, 1.0);

            // Buildings & ground-floor window strips above camera horizon (do not mask truck cargo box!)
            const float isBldg = (1.0 - isSky) * (1.0 - isRoad) * (1.0 - isTruckBox) * (1.0 - isVehGlass) * (isSilverMetallic ? 0.0 : 1.0) * smoothstep(camHorizV, camHorizV - 0.038, vFrac) * 0.95;

            gxAcc += gx;
            gyAcc += gy;
            motAcc += mot;
            vehScoreAcc += isVeh;
            pedScoreAcc += isPed;
            sigScoreAcc += isSig;
            if (isSig > 0.45) sigStrongAcc += 1.0;
            poleSignAcc += isPoleOrSign;
            if (isPoleOrSign >= 0.45) poleStrongAcc += 1.0;
            roadScoreAcc += isRoad;
            skyScoreAcc += isSky;
            bldgScoreAcc += isBldg;
            lumAcc += lC;
      if (max(isVeh, max(isPed, isSig)) > 0.23) {
        const float kHalfFrac = 0.35;
        const float halfX = max(kHalfFrac, kHalfFrac * float(stepX));
        const float halfY = max(kHalfFrac, kHalfFrac * float(stepY));
        const float u0 = (float(spx) + 0.5 - halfX) / float(pc.camWidth);
        const float v0 = (float(spy) + 0.5 - halfY) / float(pc.camHeight);
        const float u1 = (float(spx) + 0.5 + halfX) / float(pc.camWidth);
        const float v1 = (float(spy) + 0.5 + halfY) / float(pc.camHeight);
                minObjU = min(minObjU, u0);
                maxObjU = max(maxObjU, u1);
                minObjV = min(minObjV, v0);
                maxObjV = max(maxObjV, v1);
                hasSubObj = true;
            }
            samples += 1.0;
        }
    }

    samples = max(samples, 1.0);
    const float mGx = gxAcc / samples;
    const float mGy = gyAcc / samples;
    const float mMot = motAcc / samples;
    const float mVeh = vehScoreAcc / samples;
    const float mPed = pedScoreAcc / samples;
    const float sigFracPeak = (sigStrongAcc >= 2.0) ? clamp(sigStrongAcc / max(4.0, samples * 0.16), 0.0, 1.0) : 0.0;
    const float mSig = max(sigScoreAcc / samples, sigFracPeak);
    const float mPoleRaw = poleSignAcc / samples;
    const float mPoleCoh = (poleStrongAcc >= 3.0) ? clamp(mPoleRaw * 3.0, 0.0, 1.0) : mPoleRaw;
    const float mRoad = roadScoreAcc / samples;
    const float mSky = skyScoreAcc / samples;
    const float mBldg = bldgScoreAcc / samples;
    const float mLum = lumAcc / samples;

    const uint pCol = min(pc.patchCols - 1u, (fx * pc.patchCols) / pc.featWidth);
    const uint pRow = min(pc.patchRows - 1u, (fy * pc.patchRows) / pc.featHeight);
    const vec4 soilInfo = uSoilPatch.patches[cam * (pc.patchCols * pc.patchRows) + pRow * pc.patchCols + pCol];
    const float wPatch = soilInfo.y;
    const float sigmaSoil = sqrt(soilInfo.z);

    const float nx = (float(fx) + 0.5) / float(pc.featWidth) - 0.5;
    const float ny = (float(fy) + 0.5) / float(pc.featHeight) - 0.5;
    const float fovea = 1.0 + 0.35 * exp(-(nx * nx + ny * ny) * 6.0);
    const float vPrior = clamp((float(fy) + 0.5) / float(pc.featHeight), 0.0, 1.0);

    const float objEnergy = clamp((mVeh * 0.75 + mPed * 1.15 + mSig * 0.85) * fovea * wPatch, 0.0, 1.5);
    const float packedMinUV = hasSubObj ? (floor(clamp(minObjU, 0.0, 0.9999) * 2047.0 + 0.5) * 2048.0 + floor(clamp(minObjV, 0.0, 0.9999) * 2047.0 + 0.5)) : -1.0;
    const float packedMaxUV = hasSubObj ? (floor(clamp(maxObjU, 0.0, 1.0) * 2047.0 + 0.5) * 2048.0 + floor(clamp(maxObjV, 0.0, 1.0) * 2047.0 + 0.5)) : -1.0;

    const vec4 c0 = vec4(mGx, mGy, clamp((mGx + mGy) * fovea, 0.0, 2.0), packedMinUV);
    const vec4 c1 = vec4(mVeh * wPatch, mPed * wPatch, mSig * wPatch, mRoad);
    const vec4 c2 = vec4(mSky, mBldg, mMot, mPoleCoh * wPatch);
    const vec4 c3 = vec4(vPrior, wPatch, packedMaxUV, objEnergy);

    const uint baseIdx = ((cam * pc.featHeight + fy) * pc.featWidth + fx) * 4u;
    uFeatS4.feat[baseIdx + 0u] = c0;
    uFeatS4.feat[baseIdx + 1u] = c1;
    uFeatS4.feat[baseIdx + 2u] = c2;
    uFeatS4.feat[baseIdx + 3u] = c3;

    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    s_block[ly][lx][0] = c0;
    s_block[ly][lx][1] = c1;
    s_block[ly][lx][2] = c2;
    s_block[ly][lx][3] = c3;
    barrier();

    if ((lx & 1u) == 0u && (ly & 1u) == 0u && (fx + 1u) < pc.featWidth && (fy + 1u) < pc.featHeight) {
        const uint s5W = pc.featWidth / 2u;
        const uint s5H = pc.featHeight / 2u;
        const uint s5Idx = ((cam * s5H + (fy / 2u)) * s5W + (fx / 2u)) * 4u;
        for (int k = 0; k < 4; ++k) {
            vec4 avg = 0.25 * (
                s_block[ly][lx][k] +
                s_block[ly][lx + 1u][k] +
                s_block[ly + 1u][lx][k] +
                s_block[ly + 1u][lx + 1u][k]
            );
            // Preserve compact distant signal bulbs (1 S4 cell) against 2x2 average dilution
            if (k == 1) {
                const float maxSig = max(max(s_block[ly][lx][1].z, s_block[ly + 1u][lx][1].z),
                                         max(s_block[ly][lx + 1u][1].z, s_block[ly + 1u][lx + 1u][1].z));
                avg.z = max(avg.z, maxSig * 0.72);
            }
            uFeatS5.feat[s5Idx + uint(k)] = avg;
        }
    }
}
