#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Stage 5b: BEVFormer Spatial Cross-Attention across all 8 Calibrated Cameras
// Projects 3D pillar points (x_ego, y_ego, z_k) into all 8 cameras via K_c * T_{cam<-ego},
// applies Brown-Conrady distortion lookup, samples encoder memory features, and weights each
// camera's contribution by its SoilDetector patch confidence w_c(u, v).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct CamProjGpu {
    mat4 camFromEgoISO;   // 4x4 transform ISO Ego -> CV Camera frame
    vec4 intr;            // fx, fy, cx, cy
    vec4 dist;            // k1, k2, p1, p2
    vec4 dims;            // width, height, maxRange, camSummaryWeight
};

layout(std430, binding = 0) readonly buffer CamProjBuf {
    CamProjGpu cams[8];
} uCamProj;

layout(std430, binding = 1) readonly buffer EncMemoryIn {
    vec4 feat[]; // 8 * 30 * 40 * 4
} uEncMemory;

layout(std430, binding = 2) readonly buffer SoilPatchIn {
    vec4 patches[]; // 8 * 80
} uSoilPatch;

layout(std430, binding = 3) readonly buffer WarpedBevFeatIn {
    vec4 feat[];
} uWarpedBevFeat;

layout(std430, binding = 4) readonly buffer WarpedBevMetaIn {
    vec4 meta[];
} uWarpedBevMeta;

layout(std430, binding = 5) writeonly buffer CurrBevFeatOut {
    vec4 feat[];
} uCurrBevFeat;

layout(std430, binding = 6) writeonly buffer CurrBevMetaOut {
    vec4 meta[]; // vec4(obsWeight, epistemicVar, camHitCount, temporalDelta)
} uCurrBevMeta;

layout(std430, binding = 7) writeonly buffer BevPillarHeightOut {
    vec4 zResponses[]; // 4 Z-anchor activations per (ix, iy) cell
} uBevPillarHeight;

layout(push_constant) uniform BevSpatialPC {
    vec4 zAnchors;
    uint nx;
    uint ny;
    uint featW;
    uint featH;
    uint patchCols;
    uint patchRows;
    float minX;
    float maxX;
    float minY;
    float maxY;
} pc;

vec4 sampleEncMem(uint cam, float uNorm, float vNorm, uint slot) {
    float fx = clamp(uNorm * float(pc.featW) - 0.5, 0.0, float(pc.featW - 1u));
    float fy = clamp(vNorm * float(pc.featH) - 0.5, 0.0, float(pc.featH - 1u));
    int x0 = int(floor(fx));
    int y0 = int(floor(fy));
    int x1 = min(x0 + 1, int(pc.featW) - 1);
    int y1 = min(y0 + 1, int(pc.featH) - 1);
    float ax = fx - float(x0);
    float ay = fy - float(y0);

    vec4 v00 = uEncMemory.feat[((cam * pc.featH + uint(y0)) * pc.featW + uint(x0)) * 4u + slot];
    vec4 v10 = uEncMemory.feat[((cam * pc.featH + uint(y0)) * pc.featW + uint(x1)) * 4u + slot];
    vec4 v01 = uEncMemory.feat[((cam * pc.featH + uint(y1)) * pc.featW + uint(x0)) * 4u + slot];
    vec4 v11 = uEncMemory.feat[((cam * pc.featH + uint(y1)) * pc.featW + uint(x1)) * 4u + slot];
    return mix(mix(v00, v10, ax), mix(v01, v11, ax), ay);
}

void main() {
    uint ix = gl_GlobalInvocationID.x;
    uint iy = gl_GlobalInvocationID.y;
    if (ix >= pc.nx || iy >= pc.ny) return;

    float stepX = (pc.maxX - pc.minX) / float(pc.nx);
    float stepY = (pc.maxY - pc.minY) / float(pc.ny);
    float egoX = pc.minX + (float(ix) + 0.5) * stepX;
    float egoY = pc.minY + (float(iy) + 0.5) * stepY;

    float zList[4] = float[4](pc.zAnchors.x, pc.zAnchors.y, pc.zAnchors.z, pc.zAnchors.w);
    vec4 agg[4];
    for (int s = 0; s < 4; ++s) agg[s] = vec4(0.0);

    float totalWeight = 0.0;
    float camHits = 0.0;
    float varWeightedSum = 0.0;
    vec4 zAct = vec4(0.0);

    // Ego footprint mask (ignore inside Cybercab body itself)
    bool insideEgo = (egoX > -1.1 && egoX < 3.5 && abs(egoY) < 1.15);

    if (!insideEgo) {
        for (int zi = 0; zi < 4; ++zi) {
            float egoZ = zList[zi];
            float zScoreAcc = 0.0;
            float zWAcc = 0.0;

            uint hitGroupsMask = 0u;
            float camAttnW[8], camDynSal[8], camPoleW[8], camVar[8];
            vec4 camM0[8], camM1[8], camM2[8], camM3[8];
            bool camValid[8];

            for (uint c = 0u; c < 8u; ++c) {
                camValid[c] = false;
                CamProjGpu cp = uCamProj.cams[c];
                vec4 pCam = cp.camFromEgoISO * vec4(egoX, egoY, egoZ, 1.0);
                if (pCam.z < 0.7 || pCam.z > cp.dims.z) continue;

                const float xn = pCam.x / pCam.z;
                const float yn = pCam.y / pCam.z;
                const float r2 = xn * xn + yn * yn;
                if (r2 > 3.2) continue;

                // Forward Brown-Conrady distortion matching ISP shader (from common.glsl)
                const vec2 distXY = brownConradyDistort(vec2(xn, yn), cp.dist);
                const float xd = distXY.x;
                const float yd = distXY.y;

                float uPx = cp.intr.x * xd + cp.intr.z;
                float vPx = cp.intr.y * yd + cp.intr.w;
                float uNorm = uPx / cp.dims.x;
                float vNorm = vPx / cp.dims.y;
                if (uNorm < 0.02 || uNorm > 0.98 || vNorm < 0.02 || vNorm > 0.98) continue;

                // Query SoilDetector patch weight w_c(u, v) and epistemic variance
                uint pCol = min(pc.patchCols - 1u, uint(uNorm * float(pc.patchCols)));
                uint pRow = min(pc.patchRows - 1u, uint(vNorm * float(pc.patchRows)));
                vec4 soilInfo = uSoilPatch.patches[c * (pc.patchCols * pc.patchRows) + pRow * pc.patchCols + pCol];
                float wPatch = soilInfo.y;
                float varPatch = soilInfo.z;

                vec4 m0 = sampleEncMem(c, uNorm, vNorm, 0u);
                vec4 m1 = sampleEncMem(c, uNorm, vNorm, 1u);
                vec4 m2 = sampleEncMem(c, uNorm, vNorm, 2u);
                vec4 m3 = sampleEncMem(c, uNorm, vNorm, 3u);

                float poleResp = m2.w;
                if (c < 5u) {
                    float duCell = 0.30 / float(pc.featW);
                    poleResp = max(poleResp, max(sampleEncMem(c, clamp(uNorm - duCell, 0.01, 0.99), vNorm, 2u).w,
                                                 sampleEncMem(c, clamp(uNorm + duCell, 0.01, 0.99), vNorm, 2u).w));
                }
                float poleRangeGate = (c >= 5u) ? smoothstep(13.5, 10.5, pCam.z) : smoothstep(18.0, 15.8, pCam.z);
                float poleHitThresh = (c >= 5u) ? 0.28 : 0.16;
                if (wPatch > 0.30 && poleResp > poleHitThresh && poleRangeGate > 0.05) {
                    uint grpBit = (c < 3u) ? 1u : (1u << (c - 2u));
                    hitGroupsMask |= grpBit;
                }

                // Deformable spatial cross-attention weight (prefers sharp center rays & unsoiled cameras)
                float rangeAtten = 1.0 / (1.0 + 0.025 * pCam.z);
                float centerAtten = 1.0 - 0.35 * length(vec2(uNorm - 0.5, vNorm - 0.5));
                float attnW = wPatch * rangeAtten * centerAtten;

                camValid[c] = true;
                camAttnW[c] = attnW;
                camVar[c] = varPatch;
                camM0[c] = m0;
                camM1[c] = m1;
                camM2[c] = vec4(m2.xyz, m2.w * poleRangeGate);
                camM3[c] = m3;
                camDynSal[c] = (m1.x * 1.05 + m1.y * 1.35 + m1.z * 1.1) * clamp(1.0 - m2.x * 1.3 - m1.w * 0.7, 0.0, 1.0);
                camPoleW[c] = (m2.w * poleRangeGate) * clamp(1.0 - m1.x * 1.5 - m1.y * 1.5, 0.0, 1.0);
                if (zi == 1) camHits += wPatch;
            }

            const float poleParallaxGate = (bitCount(hitGroupsMask) >= 2) ? 1.0 : 0.0;
            for (uint c = 0u; c < 8u; ++c) {
                if (!camValid[c]) continue;
                float attnW = camAttnW[c];
                vec4 m2Gated = vec4(camM2[c].xyz, camM2[c].w * poleParallaxGate);

                agg[0] += camM0[c] * attnW;
                agg[1] += camM1[c] * attnW;
                agg[2] += m2Gated * attnW;
                agg[3] += camM3[c] * attnW;
                totalWeight += attnW;
                varWeightedSum += camVar[c] * attnW;

                float objSal = camDynSal[c] + camPoleW[c] * 2.25 * poleParallaxGate;
                zScoreAcc += objSal * attnW;
                zWAcc += attnW;
            }
            if (zWAcc > 1e-4) {
                zAct[zi] = zScoreAcc / zWAcc;
            }
        }
    }

    uint cellIdx = iy * pc.nx + ix;
    uint base = cellIdx * 4u;
    vec4 warpedMeta = uWarpedBevMeta.meta[cellIdx];

    if (totalWeight > 1e-4) {
        for (int s = 0; s < 4; ++s) agg[s] /= totalWeight;
    }

    // Fuse Spatial Cross-Attention + Temporal Self-Attention (weighted by spatial vs temporal reliability)
    float spatialConf = clamp(totalWeight * 0.55, 0.0, 1.0);
    float temporalConf = warpedMeta.x;
    float alpha = spatialConf / max(spatialConf + temporalConf * 0.65, 1e-4);

    vec4 prevFeat0 = uWarpedBevFeat.feat[base + 0u];
    vec4 prevFeat1 = uWarpedBevFeat.feat[base + 1u];
    vec4 prevFeat2 = uWarpedBevFeat.feat[base + 2u];
    vec4 prevFeat3 = uWarpedBevFeat.feat[base + 3u];

    vec4 fused0 = mix(prevFeat0, agg[0], alpha);
    vec4 fused1 = mix(prevFeat1, agg[1], alpha);
    vec4 fused2 = mix(prevFeat2, agg[2], alpha);
    vec4 fused3 = mix(prevFeat3, agg[3], alpha);

    uCurrBevFeat.feat[base + 0u] = fused0;
    uCurrBevFeat.feat[base + 1u] = fused1;
    uCurrBevFeat.feat[base + 2u] = fused2;
    uCurrBevFeat.feat[base + 3u] = fused3;

    float spatialVar = (totalWeight > 1e-4) ? (varWeightedSum / totalWeight) : 1.0;
    float fusedVar = mix(warpedMeta.y, spatialVar, alpha);
    float tempDelta = length(fused1.xyz - prevFeat1.xyz);

    uCurrBevMeta.meta[cellIdx] = vec4(max(spatialConf, temporalConf * 0.85), fusedVar, camHits, tempDelta);
    uBevPillarHeight.zResponses[cellIdx] = zAct;
}
